# =============================================================================
# ThreatDetect environment
#
# Copy to `.env.local` (gitignored) for local development.
# =============================================================================

# Signs the session JWT for the local password auth. REQUIRED in production —
# the app refuses to serve authenticated routes without it, rather than
# silently signing sessions with a value that is public in this repository.
#
# Generate one with:
#   openssl rand -base64 32
#
# In development this may be omitted; a fixed fallback is used and a warning is
# logged. Never rely on that fallback outside development.
SESSION_SECRET=

# Origin of the FastAPI backend, e.g. http://localhost:8000
#
# When set, "Continue with Google" points at GET /auth/google — the API's real
# authentication path — and lib/api/client.js can reach every documented
# endpoint. When unset, Google sign-in is disabled with an explanation and the
# console runs against its local demo store.
#
# The backend session is a cookie, so requests are sent with
# `credentials: "include"`. That means the API's CORS policy must name this
# frontend's origin explicitly; a wildcard is not permitted with credentialed
# requests.
NEXT_PUBLIC_API_URL=
