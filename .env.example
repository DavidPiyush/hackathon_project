# =============================================================================
# ThreatDetect environment
#
# Copy to `.env.local` (gitignored) for local development.
# =============================================================================

# Signs the session JWT. REQUIRED in production — the app refuses to serve
# authenticated routes without it, rather than silently signing sessions with a
# value that is public in this repository.
#
# Generate one with:
#   openssl rand -base64 32
#
# In development this may be omitted; a fixed fallback is used and a warning is
# logged. Never rely on that fallback outside development.
SESSION_SECRET=
